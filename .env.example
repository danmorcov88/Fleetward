# Host overrides for the development stack.
#
# Copy to .env and change any value that collides with something already running on your machine.
# The port settings affect only the host side of each mapping; nothing inside the stack changes.

#FLEETWARD_HTTP_PORT=8080           # control plane REST API
#FLEETWARD_GRPC_PORT=9090           # control plane gRPC
#FLEETWARD_WEB_PORT=3000            # web UI
#FLEETWARD_POSTGRES_PORT=5432       # metadata database
#FLEETWARD_VM_PORT=8428             # VictoriaMetrics
#FLEETWARD_MINIO_PORT=9000          # MinIO S3 API
#FLEETWARD_MINIO_CONSOLE_PORT=9001  # MinIO web console
#FLEETWARD_DEX_PORT=5556            # Dex OIDC provider
#FLEETWARD_SQLSERVER_PORT=1433      # the SQL Server instance the quickstart watches

# Group that owns the Docker socket, granted to the unprivileged control-plane user so backup
# verification can provision sandbox containers. The default of 0 is correct on macOS, where the
# socket inside the Docker Desktop VM is root:root. On a Linux host it is root:docker, so set this
# to the host's docker GID or /readyz will report the sandbox component unhealthy:
#
#   echo "FLEETWARD_DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env
#
#FLEETWARD_DOCKER_GID=0
