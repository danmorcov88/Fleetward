# Development image for the web UI: Vite dev server with hot reload, proxying /api to the control
# plane. A production image would build to static assets and serve them from a CDN or the control
# plane itself; that arrives with Stage 6.
FROM node:26-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
